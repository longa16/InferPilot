FROM ghcr.io/astral-sh/uv:0.9.5 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /srv
ENV UV_CACHE_DIR=/tmp/uv-cache UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_CONCURRENT_DOWNLOADS=3 \
    PYTHONUNBUFFERED=1 PORT=8080
COPY pyproject.toml uv.lock ./
# Optional enterprise proxy trust bundle. TLS verification always remains enabled.
RUN --mount=type=cache,target=/tmp/uv-cache,sharing=locked \
    --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then \
      SSL_CERT_FILE=/run/secrets/ca_bundle UV_NATIVE_TLS=true uv sync --frozen --no-dev; \
    else uv sync --frozen --no-dev; fi
COPY inferpilot ./inferpilot
COPY migrations ./migrations
COPY datasets ./datasets
COPY documents ./documents
RUN useradd --uid 10001 --create-home inferpilot && chown -R inferpilot:inferpilot /srv
USER inferpilot
EXPOSE 8080
CMD ["sh", "-c", "exec .venv/bin/uvicorn inferpilot.api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
