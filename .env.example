GENERATION_MODE=groq
# Clé à renseigner uniquement dans .env (ignoré par Git) ou via les secrets cloud.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Facultatif : token Hugging Face en lecture pour augmenter les limites de téléchargement.
HF_TOKEN=
# Pour consulter les sources sans appeler Groq : GENERATION_MODE=extractive
