# Existing NovaMaison direct mode (compose.yaml)
GENERATION_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HF_TOKEN=
# InferPilot platform (compose.inferpilot.yaml)
# Generate distinct random values; never commit your .env.
POSTGRES_PASSWORD=
ADMIN_AUTH_SECRET=
HMAC_SECRET=
AGENT_MODEL=llama-3.3-70b-versatile
RETENTION_DAYS=30
# No built-in model prices. Populate only after verifying current provider tariffs.
PRICING_JSON={}
# Create an application in the dashboard, then put its one-time gateway key here:
LLM_GATEWAY_KEY=
# Local Python mode only (leave empty when using Compose):
# DATABASE_URL=postgresql://...
# Optional for NovaMaison outside Compose:
# LLM_BASE_URL=http://localhost:8080/v1
